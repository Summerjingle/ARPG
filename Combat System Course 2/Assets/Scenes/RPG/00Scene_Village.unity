  - "\u5982\u679C\u4F60\u80FD\u9664\u6389\u5B83\uFF0C\u6211\u613F\u610F\u7ED9\u4F60\u4E00\u5927\u7B14\u94B1"
  inProgressDialogue:
  - "\u8FD8\u6123\u7740\u5E72\u4EC0\u4E48\uFF0C\u8D76\u7D27\u53BB\u628A\u4F60\u7684\u4E8B\u505A\u5B8C\uFF01"
  canCompleteDialogue:
  - "\u5C31\u7B97\u6CA1\u6709\u4F60\uFF0C\u6211\u4E5F\u80FD\u628A\u8FD9\u5934\u8822\u72FC\u6740\u6389"
  - "\u4F60\u8BF4\u8D4F\u91D1\uFF0C\u6211\u8FD9\u6709\u6BD4\u8D4F\u91D1\u66F4\u597D\u7684\u4E1C\u897F\u2026\u2026"
  - "\u5728\u6751\u5B50\u91CC\u7684\u5C71\u6D1E\u91CC\uFF0C\u4F4F\u7740\u4E00\u4E2A\u6709\u94B1\u7684\u5730\u7CBE\uFF0C\u6216\u8BB8\u4F60\u53EF\u4EE5\u5728\u5B83\u90A3\u91CC\u78B0\u78B0\u8FD0\u6C14"
  completionDialogue:
  - "\u770B\u4EC0\u4E48\u770B\uFF0C\u6211\u53EF\u6CA1\u6709\u94B1\uFF01"
